# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Session pooler" connection string (used by npm run db:setup / test:race only)
DATABASE_URL=

# Staff who get the admin panel (comma separated). Used by npm run db:setup.
ADMIN_EMAILS=

# Public address of the app (calendar feed links point here). Defaults to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=

# Razorpay test keys (optional). Leave blank to use the built-in demo checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
